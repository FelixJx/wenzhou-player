# 复制为 .env 后填写；绝不要把真实密钥提交到仓库

# 监听地址与端口。默认只听本机，由同机 nginx 反代；本地直连调试才改 HOST=0.0.0.0
HOST=127.0.0.1
PORT=8790

# SQLite 文件路径（相对 server/ 目录或绝对路径）
DB_PATH=./data/wz.db

# 名人大脑。AI_PROTOCOL 二选一：
#   anthropic（默认）→ Anthropic 兼容 /v1/messages
#   openai           → OpenAI 兼容 /chat/completions（思考模型自动带 enable_thinking:false）
# 三项（BASE_URL/API_KEY/MODEL）缺一则名人全部走模板。
#
# 方案一：dashscope OpenAI 兼容端点（推荐，qwen3.8-max 实测 1.6s 内出文本）
#   AI_PROTOCOL=openai
#   AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   AI_MODEL=qwen3.8-max
#
# 方案二：dashscope Anthropic 兼容端点（注意：思考模型会先想后说，易超 3 秒）
#   AI_PROTOCOL=anthropic
#   AI_BASE_URL=https://dashscope.aliyuncs.com/apps/anthropic
#   AI_MODEL=qwen-plus
#
# 方案三：周六现场局域网 DeepSeek（Mac mini 192.168.3.124 起 LLM 服务）
#   AI_PROTOCOL=openai
#   AI_BASE_URL=http://192.168.3.124:8000/v1
#   AI_MODEL=deepseek-v4.1-flash
#   AI_API_KEY 留空
AI_PROTOCOL=openai
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=qwen3.8-max
